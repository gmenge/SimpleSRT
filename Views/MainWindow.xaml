<Window x:Class="SimpleSRT.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SimpleSRT - Painel de Controle" Height="390" Width="870"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Icon="pack://application:,,,/srt.ico">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Painel 1: Configurações do SRT -->
        <Border Grid.Row="0" Background="#2D2D30" CornerRadius="6" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Modo SRT -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Modo SRT" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding SrtModes}" 
                              SelectedItem="{Binding SelectedMode}" 
                              Height="30" 
                              VerticalContentAlignment="Center"
                              Foreground="Black"/>
                </StackPanel>

                <!-- IP / Host -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="IP / Host" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" 
                             IsEnabled="{Binding IsHostEnabled}"
                             Height="30" 
                             VerticalContentAlignment="Center" 
                             Padding="5,0"
                             Foreground="Black"
                             Background="White"/>
                </StackPanel>

                <!-- Porta -->
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Porta" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" 
                             Height="30" 
                             VerticalContentAlignment="Center" 
                             Padding="5,0"
                             Foreground="Black"
                             Background="White"/>
                </StackPanel>

                <!-- Latência -->
                <StackPanel Grid.Column="6">
                    <TextBlock Text="Latência (ms)" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding LatencyMs, UpdateSourceTrigger=PropertyChanged}" 
                             Height="30" 
                             VerticalContentAlignment="Center" 
                             Padding="5,0"
                             Foreground="Black"
                             Background="White"/>
                </StackPanel>

                <!-- Stream ID -->
                <StackPanel Grid.Column="8">
                    <TextBlock Text="Stream ID" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding StreamId, UpdateSourceTrigger=PropertyChanged}" 
                             Height="30" 
                             VerticalContentAlignment="Center" 
                             Padding="5,0"
                             Foreground="Black"
                             Background="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Painel 2: Configurações de Áudio -->
        <Border Grid.Row="2" Background="#2D2D30" CornerRadius="6" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>

                <!-- Saída de Áudio -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Dispositivo de Saída de Áudio" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding AudioDevices}"
                              SelectedItem="{Binding SelectedAudioDevice}"
                              DisplayMemberPath="Name"
                              Height="30"
                              VerticalContentAlignment="Center"
                              Foreground="Black"/>
                </StackPanel>

                <!-- Controle de Volume -->
                <StackPanel Grid.Column="2">
                    <Grid Margin="0,0,0,5">
                        <TextBlock Text="Volume" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding Volume, StringFormat={}{0}%}" Foreground="Gray" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider Value="{Binding Volume}" Minimum="0" Maximum="100" Height="30" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Mute -->
                <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                    <Button Command="{Binding ToggleMuteCommand}"
                            Height="30"
                            Background="#3E3E42" Foreground="White"
                            BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="Mute"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                        <Setter Property="Content" Value="Unmute"/>
                                        <Setter Property="Background" Value="#D9534F"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Painel 3: Saída de Vídeo Hardware (Blackmagic DeckLink) -->
        <Border Grid.Row="4" Background="#2D2D30" CornerRadius="6" Padding="15">
            <StackPanel>
                <TextBlock Text="Saída de Vídeo SDI (Blackmagic DeckLink)" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding DeckLinkDevices}"
                          SelectedItem="{Binding SelectedDeckLinkDevice}"
                          DisplayMemberPath="Name"
                          Height="30"
                          VerticalContentAlignment="Center"
                          Foreground="Black"/>
            </StackPanel>
        </Border>

        <!-- Painel Inferior: Botões de Controle -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Botões de Conexão -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="Conectar" 
                        Command="{Binding ConnectCommand}" 
                        Width="120" Height="35" 
                        Background="#007ACC" Foreground="White" 
                        FontWeight="Bold" BorderThickness="0" 
                        Margin="0,0,10,0"/>

                <Button Content="Desconectar" 
                        Command="{Binding DisconnectCommand}" 
                        Width="120" Height="35" 
                        Background="#D9534F" Foreground="White" 
                        FontWeight="Bold" BorderThickness="0"/>
            </StackPanel>

            <!-- Ações da Janela de Vídeo -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="Fullscreen (F11 / Alt+Enter)" 
                          IsChecked="{Binding IsFullscreen}" 
                          Foreground="White" 
                          VerticalAlignment="Center" 
                          Margin="0,0,15,0"/>

                <Button Content="Abrir / Esconder Vídeo" 
                        Command="{Binding ToggleVideoWindowCommand}" 
                        Width="160" Height="35" 
                        Background="#3E3E42" Foreground="White" 
                        BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>