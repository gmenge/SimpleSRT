<Window x:Class="SimpleSRT.App.Views.VideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="SimpleSRT - Vídeo Output" 
        Height="450" 
        Width="800"
        Background="Black"
        WindowStartupLocation="Manual"
        Icon="pack://application:,,,/srt.ico"
        KeyDown="Window_KeyDown">

    <Grid x:Name="RootGrid" Background="Black">
        <!-- Fundo Preto Permanente -->
        <Border Background="Black" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- VideoView inicia transparente (Opacity="0") sobre o fundo preto -->
        <vlc:VideoView x:Name="VideoPlayerView" 
                       HorizontalAlignment="Stretch" 
                       VerticalAlignment="Stretch"
                       Background="Black"
                       Opacity="0" />
    </Grid>
</Window>